{
  "name": "relatorios-avaliacao-totvs",
  "version": "0.1.0",
  "private": true,
  "description": "Automação de relatórios de avaliação (TOTVS RM: EDU.BI.004/005/006)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "docx": "^9.15.3",
    "echarts": "^5.6.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "msw": "^2.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "fetch": "tsx src/cli.ts fetch",
    "transform": "tsx src/cli.ts transform",
    "render:charts": "tsx src/cli.ts render:charts",
    "render:xlsx": "tsx src/cli.ts render:xlsx",
    "render:docx": "tsx src/cli.ts render:docx",
    "package": "tsx src/cli.ts package",
    "pipeline": "tsx src/cli.ts pipeline",
    "pipeline:mock": "tsx --env-file=.env.mock src/cli.ts pipeline",
    "clean": "tsx src/cli.ts clean",
    "mock:generate": "tsx mock/generate.ts",
    "mock:serve": "tsx --env-file=.env.mock mock/serve.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --exclude '**/*.e2e.test.ts'",
    "test:coverage": "vitest run --coverage --exclude '**/*.e2e.test.ts'",
    "docker:mock": "docker compose --profile mock up --build --abort-on-container-exit --exit-code-from pipeline-mock",
    "docker:prod": "docker compose --profile prod run --rm --build pipeline",
    "test:e2e": "vitest run tests/integration/pipeline.e2e.test.ts"
  }
}
