# Copie para .env (uso local) ou .env.prod (Docker, perfil prod) e preencha.
TOTVS_BASE_URL=https://gestaoescolar.fiepb.org.br
TOTVS_COLIGADA=2
TOTVS_SISTEMA=S
TOTVS_USER=
TOTVS_PASSWORD=
HTTP_TIMEOUT_MS=600000
HTTP_RETRIES=3
# ANO_LETIVO=2026
RENDER_CONCURRENCY=4
DATA_DIR=./data
WORK_DIR=./work
OUTPUT_DIR=./output
# Gráficos por tipo de relatório (lista separada por vírgula: media, questoes; vazio = nenhum)
GRAFICOS_PROFESSOR=questoes
GRAFICOS_PROVA=media
# Template do Word usado em todos os documentos (timbre, margens, estilos)
DOCX_TEMPLATE=./templates/relatorio.docx
LOG_LEVEL=info
